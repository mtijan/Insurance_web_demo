# Example Nginx baseline for Kevin Assurance (customize server_name, TLS paths, and upstream).
# Never expose KEVIN_MEDIA_ROOT or /media/ statically; vault files stream only via Django.

server {
    listen 443 ssl http2;
    server_name assurance.example.test;

    # Reject oversized multipart bodies before Gunicorn/Django spools uploads to temp disk.
    client_max_body_size 52m;
    client_body_timeout 30s;

    ssl_protocols TLSv1.3 TLSv1.2;
    # Configure ssl_certificate and ssl_certificate_key in your host deployment.

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /var/www/kevin-assurance/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Enable DJANGO_TRUST_PROXY=1 only when external access to :8000 is blocked.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /admin/ {
        # Restrict /admin/ to operator allowlist CIDRs at edge/firewall in production.
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
