# Inject these variables through the process manager; Django does not auto-load this file.
# Development can use core.settings. Use core.production_settings only with real configuration.
DJANGO_SETTINGS_MODULE=core.production_settings
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=assurance.example.test
DJANGO_TRUSTED_ORIGINS=https://assurance.example.test
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
KEVIN_MEDIA_ROOT=/var/secure_media
# Enable only when the application is isolated behind a proxy replacing forwarded headers.
DJANGO_TRUST_PROXY=0
