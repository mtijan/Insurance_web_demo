# Copy to .env.postgres.local for core.local_postgres_settings only.
# The provisioning SQL and matching local credentials are prepared under .local/.
DJANGO_SECRET_KEY=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=kevin_assurance_local
POSTGRES_USER=kevin_assurance_local
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
